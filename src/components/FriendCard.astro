---
import WikiIcon from './WikiIcon.astro';

interface Props {
  name: string;
  href: string;
  avatar: string;
  description: string;
}

const { name, href, avatar, description } = Astro.props;
---

<a href={href} target="_blank" rel="noopener noreferrer" class="friend-card">
  <img class="avatar" src={avatar} alt={`${name} 的图标`} loading="lazy" />
  <span class="stack">
    <strong class="title">{name}</strong>
    <span class="description">{description}</span>
  </span>
  <WikiIcon name="material-symbols:arrow-forward" size="1.333em" class="arrow" />
</a>

<style>
  @layer starlight.components {
    .friend-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding: 1rem;
      box-shadow: var(--sl-shadow-sm);
      text-decoration: none;
      transition:
        border-color 0.2s ease,
        background-color 0.2s ease;
    }
    .friend-card:hover {
      background: var(--sl-color-gray-7, var(--sl-color-gray-6));
      border-color: var(--sl-color-gray-2);
    }
    .friend-card .avatar {
      width: 3rem;
      height: 3rem;
      margin: 0;
      border-radius: 9999px;
      background-color: white;
      object-fit: cover;
    }
    .friend-card .stack {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
    }
    .friend-card .title {
      color: var(--sl-color-white);
      font-weight: 600;
      font-size: var(--sl-text-lg);
      line-height: var(--sl-line-height-headings);
    }
    .friend-card .description {
      color: var(--sl-color-gray-3);
      line-height: 1.5;
    }
    .friend-card .arrow {
      color: var(--sl-color-gray-3);
    }
    .friend-card:hover .arrow {
      color: var(--sl-color-white);
    }
  }
</style>
