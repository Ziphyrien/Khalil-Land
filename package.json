{
  "name": "khalil-land-wiki",
  "version": "0.0.1",
  "description": "Minecraft 服务器 Khalil Land（知己屿）的文档站，欢迎大家共同编辑！",
  "license": "MIT",
  "author": "Ziphyrien <2697860027@qq.com>",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "bun run build && wrangler deploy",
    "preview": "astro preview",
    "format": "vp fmt README.md src/content/docs && autocorrect --fix README.md src/content/docs && textlint --fix README.md \"src/content/docs/**/*.{md,mdx}\"",
    "prose:check": "autocorrect --lint --strict README.md src/content/docs && textlint README.md \"src/content/docs/**/*.{md,mdx}\"",
    "check": "vp check && astro check",
    "ready": "vp run check && astro build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.3",
    "@astrojs/starlight": "^0.41.7",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@fontsource/cascadia-code": "5.3.0",
    "@iconify-json/material-symbols": "^1.2.89",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify/utils": "^3.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "remark-cjk-friendly": "2.3.1",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "sharp": "^0.35.3",
    "starlight-giscus": "1.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "autocorrect-node": "2.14.0",
    "textlint": "15.8.0",
    "textlint-rule-write-good": "2.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7",
    "wrangler": "^4.124.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
  },
  "packageManager": "bun@1.3.14"
}
