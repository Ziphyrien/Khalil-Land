{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khalil-land",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wiki.zipawa.top/*",
      "zone_name": "zipawa.top",
      "custom_domain": false,
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
